{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "references": [
    { "path": "packages/contracts" },
    { "path": "packages/i18n" },
    { "path": "packages/ui" },
    { "path": "apps/desktop" },
    { "path": "apps/web" }
  ],
  "files": []
}