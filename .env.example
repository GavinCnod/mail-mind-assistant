# MailMind Environment Variables Example

# Web Application Settings
DEMO_LLM_BASE_URL=https://api.openai.com/v1
DEMO_LLM_API_KEY=your-api-key-here
DEMO_LLM_MODEL=gpt-4o-mini
DEMO_SESSION_MAX_EMAILS=10
DEMO_ALLOWED_ORIGINS=http://localhost:3000,https://demo.mailmind.app

# Web Server
NODE_ENV=production
PORT=3000

# Security
SESSION_TIMEOUT_MS=3600000

# Desktop (Development Only)
VITE_DEFAULT_LLM_BASE_URL=
VITE_DEFAULT_LLM_MODEL=

# Note: Do not commit real API keys or passwords to version control.
# Use .env.local for local development and set environment variables
# in your deployment platform for production.
